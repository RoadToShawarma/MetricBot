<Window x:Class="MetricBot.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Consolas">

    <StackPanel>

        <!-- Логотип, редакция и версия -->
        <Border Background="{StaticResource SurfaceBrush}"
                Height="92"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock FontFamily="Consolas"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                        <Run Foreground="#E0E0E0" Text="Metric"/><Run Foreground="{StaticResource AccentBrush}" Text="Bot"/>
                    </TextBlock>

                <TextBlock x:Name="TxtEdition"
                           Margin="0,4,0,0"
                           Style="{StaticResource MonoLabel}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{StaticResource Text2Brush}"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="TxtVersion"
                           Margin="0,3,0,0"
                           Text="v1.0.1"
                           Style="{StaticResource MonoLabel}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{StaticResource Text2Brush}"/>
                </StackPanel>

                <Image Source="Assets/Icons/application.png"
                       Width="58" Height="58"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Инфо -->
        <StackPanel Margin="24,14,24,14" TextElement.FontFamily="Consolas">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="23"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Функционал:"
                           Style="{StaticResource MonoLabel}"
                           FontSize="12"
                           Foreground="{StaticResource Text2Brush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtFunctionality" Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource MonoLabel}"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Код:"
                           Style="{StaticResource MonoLabel}"
                           FontSize="12"
                           Foreground="{StaticResource Text2Brush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCode" Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource MonoLabel}"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="UI/UX:"
                           Style="{StaticResource MonoLabel}"
                           FontSize="12"
                           Foreground="{StaticResource Text2Brush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtUi" Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource MonoLabel}"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Страница проекта:"
                           Style="{StaticResource MonoLabel}"
                           FontSize="12"
                           Foreground="{StaticResource Text2Brush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtSupport" Grid.Row="3" Grid.Column="1"
                           Style="{StaticResource MonoLabel}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           MouseLeftButtonUp="TxtSupport_Click"/>
            </Grid>
        </StackPanel>

        <!-- Описание -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Margin="22,14,22,17">
                <TextBlock Style="{StaticResource MonoLabel}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{StaticResource Text2Brush}"
                           TextWrapping="Wrap">
                    <Run Text="MetricBot" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/><Run Text=" — программа для автоматического посещения заданных веб-страниц через настраиваемые интервалы"/>
                </TextBlock>
                <TextBlock Margin="0,16,0,0"
                           Style="{StaticResource MonoLabel}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{StaticResource Text2Brush}"
                           TextWrapping="Wrap"
                           Text="Помогает поддерживать регулярную активность на сайтах и избавляет от необходимости открывать нужные страницы вручную"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
