<Window x:Class="MetricBot.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Consolas">

    <StackPanel>

        <!-- Логотип + версия -->
        <Border Background="{StaticResource SurfaceBrush}"
                Height="68"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           FontFamily="Consolas"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center">
                    <Run Foreground="#E0E0E0" Text="Metric"/><Run Foreground="{StaticResource AccentBrush}" Text="Bot"/>
                </TextBlock>

                <TextBlock x:Name="TxtVersion"
                           Grid.Column="1"
                           Text="v1.0.0"
                           Style="{StaticResource MonoLabel}"
                           FontSize="11"
                           Foreground="{StaticResource Text2Brush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Инфо -->
        <StackPanel Margin="24,20,24,0">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Функционал:"
                           Style="{StaticResource MonoLabel}"
                           FontSize="11"
                           Foreground="{StaticResource Text2Brush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtFunctionality" Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource MonoLabel}"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Код:"
                           Style="{StaticResource MonoLabel}"
                           FontSize="11"
                           Foreground="{StaticResource Text2Brush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCode" Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource MonoLabel}"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="UI/UX:"
                           Style="{StaticResource MonoLabel}"
                           FontSize="11"
                           Foreground="{StaticResource Text2Brush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtUi" Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource MonoLabel}"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Страница проекта:"
                           Style="{StaticResource MonoLabel}"
                           FontSize="11"
                           Foreground="{StaticResource Text2Brush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtSupport" Grid.Row="3" Grid.Column="1"
                           Style="{StaticResource MonoLabel}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           TextDecorations="Underline"
                           MouseLeftButtonUp="TxtSupport_Click"/>
            </Grid>
        </StackPanel>

        <!-- Кнопка -->
        <Border Background="{StaticResource SurfaceBrush}"
                Height="68"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,16,0,0">
            <Grid>
                <Button Content="Закрыть"
                        Style="{StaticResource OutlineBtn}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </StackPanel>
</Window>
