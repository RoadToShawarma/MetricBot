<Window x:Class="MetricBot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="540" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        FontFamily="Consolas">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <StackPanel Margin="20,18,20,0">

                <!-- URL -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="URL-адреса для посещения"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="каждый адрес — с новой строки"
                                   Style="{StaticResource MonoLabel}"
                                   FontSize="10"
                                   Foreground="{StaticResource Text2Brush}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource IconBtn}"
                            ToolTip="Загрузить список из TXT-файла"
                            Click="BtnImport_Click"
                            VerticalAlignment="Top">
                        <Image Source="Assets/Icons/import.png"
                               Width="18" Height="18"
                               Stretch="Uniform"/>
                    </Button>

                    <Button Grid.Column="3"
                            Style="{StaticResource IconBtn}"
                            ToolTip="Сохранить список в TXT-файл"
                            Click="BtnExport_Click"
                            VerticalAlignment="Top">
                        <Image Source="Assets/Icons/export.png"
                               Width="18" Height="18"
                               Stretch="Uniform"/>
                    </Button>
                </Grid>

                <TextBox x:Name="TxtUrls"
                         Style="{StaticResource MonoInput}"
                         Height="110"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>

                <Border Style="{StaticResource Sep}"/>

                <!-- Интервал -->
                <TextBlock Text="Интервал между визитами" Style="{StaticResource SectionLabel}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="от " Style="{StaticResource MonoLabel}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtMin" Style="{StaticResource SpinInput}" PreviewTextInput="NumOnly"/>
                    <TextBlock Text="  до " Style="{StaticResource MonoLabel}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtMax" Style="{StaticResource SpinInput}" PreviewTextInput="NumOnly"/>
                    <TextBlock Text="  минут" Style="{StaticResource MonoLabel}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Style="{StaticResource Sep}"/>

                <!-- Режим обхода -->
                <TextBlock Text="Режим обхода ссылок" Style="{StaticResource SectionLabel}"/>
                <RadioButton x:Name="RbAll"
                             Style="{StaticResource AntRB}"
                             Content="Открывать все ссылки за один обход"
                             GroupName="VisitMode"
                             Margin="0,0,0,6"/>
                <RadioButton x:Name="RbSequential"
                             Style="{StaticResource AntRB}"
                             Content="По очереди (одна ссылка за обход)"
                             GroupName="VisitMode"
                             Margin="0,0,0,6"/>
                <RadioButton x:Name="RbRandom"
                             Style="{StaticResource AntRB}"
                             Content="Случайная ссылка за обход"
                             GroupName="VisitMode"
                             Margin="0,0,0,4"/>

                <Border Style="{StaticResource Sep}"/>

                <!-- Автозапуск -->
                <TextBlock Text="Параметры автозапуска" Style="{StaticResource SectionLabel}"/>
                <CheckBox x:Name="ChkAutorun"
                          Style="{StaticResource AntCB}"
                          Content="Запускать программу при старте Windows"
                          Checked="ChkAutorun_Changed"
                          Unchecked="ChkAutorun_Changed"
                          Margin="0,0,0,6"/>
                <CheckBox x:Name="ChkMinimized"
                          Style="{StaticResource AntCB}"
                          Content="Запускать свёрнутым"
                          IsEnabled="False"
                          Margin="0,0,0,6"/>
                <CheckBox x:Name="ChkAutostart"
                          Style="{StaticResource AntCB}"
                          Content="Автоматически начинать посещения при запуске программы"
                          Margin="0,0,0,4"/>

                <Border Style="{StaticResource Sep}"/>

                <!-- Защита -->
                <TextBlock Text="Защита приложения" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="TxtPasswordStatus"
                           Style="{StaticResource MonoLabel}"
                           Foreground="{StaticResource Text2Brush}"
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnSetPassword" Content="Установить пароль"
                            Style="{StaticResource AccentBtn}" Click="BtnSetPassword_Click"/>
                    <Button x:Name="BtnChangePassword" Content="Сменить пароль"
                            Style="{StaticResource OutlineBtn}" Margin="0,0,10,0"
                            Click="BtnChangePassword_Click" Visibility="Collapsed"/>
                    <Button x:Name="BtnRemovePassword" Content="Отключить"
                            Style="{StaticResource OutlineBtn}"
                            Click="BtnRemovePassword_Click" Visibility="Collapsed"/>
                </StackPanel>

                <Border Style="{StaticResource Sep}"/>

                <!-- Логи -->
                <TextBlock Text="Журнал событий" Style="{StaticResource SectionLabel}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="Максимум строк: "
                               Style="{StaticResource MonoLabel}"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtMaxLines"
                             Style="{StaticResource SpinInput}"
                             PreviewTextInput="NumOnly"
                             Width="70"/>
                    <TextBlock Text="  (0 = без ограничений)"
                               Style="{StaticResource MonoLabel}"
                               FontSize="10"
                               Foreground="{StaticResource Text2Brush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Style="{StaticResource Sep}"/>

                <!-- Chromium -->
                <TextBlock Text="Браузер (Chromium)" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Name="TxtChromiumStatus"
                           Style="{StaticResource MonoLabel}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <Button x:Name="BtnInstall"
                        Style="{StaticResource AccentBtn}"
                        Content="Установить Chromium"
                        HorizontalAlignment="Left"
                        Click="BtnInstall_Click"/>
                <TextBlock x:Name="TxtInstallProgress"
                           Style="{StaticResource MonoLabel}"
                           FontSize="10"
                           Foreground="{StaticResource Text2Brush}"
                           Margin="0,6,0,0"
                           Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,12">
                <Button Content="Отмена"
                        Style="{StaticResource OutlineBtn}"
                        Margin="0,0,10,0"
                        Click="BtnCancel_Click"/>
                <Button Content="Сохранить"
                        Style="{StaticResource AccentBtn}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
