<Window x:Class="MetricBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MetricBot"
        Width="660" Height="520"
        MinWidth="500" MinHeight="400"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="MainWindow_PreviewMouseDown"
        FontFamily="Consolas">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <!-- Логотип -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Consolas"
						FontSize="20"
						FontWeight="Bold"
						VerticalAlignment="Center"><Run Foreground="#E0E0E0" Text="Metric"/><Run Foreground="{StaticResource AccentBrush}" Text="Bot"/>
                    </TextBlock>
                </StackPanel>

                <!-- Кнопки справа -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0">
                    <!-- Открыть лог -->
                    <Button x:Name="BtnOpenLog"
                            Style="{StaticResource IconBtn}"
                            ToolTip="Открыть файл логов"
                            Click="BtnOpenLog_Click"
                            Margin="0,0,8,0">
                        <Image Source="pack://application:,,,/Assets/Icons/Log.png"
                               Width="18" Height="18"
                               Stretch="Uniform"/>
                    </Button>

                    <!-- О программе -->
                    <Button x:Name="BtnAbout"
                            Style="{StaticResource IconBtn}"
                            ToolTip="О программе"
                            Click="BtnAbout_Click"
                            Margin="0,0,8,0">
                        <Image Source="pack://application:,,,/Assets/Icons/About.png"
                               Width="18" Height="18"
                               Stretch="Uniform"/>
                    </Button>

                    <!-- Настройки -->
                    <Button x:Name="BtnSettings"
                            Style="{StaticResource IconBtn}"
                            ToolTip="Настройки"
                            Click="BtnSettings_Click">
                        <Image Source="pack://application:,,,/Assets/Icons/Settings.png"
                               Width="18" Height="18"
                               Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Лог -->
        <Border Grid.Row="1"
                Background="{StaticResource LogBgBrush}"
                Margin="0"
                BorderThickness="0">
            <RichTextBox x:Name="LogBox"
                         Background="{StaticResource LogBgBrush}"
                         BorderThickness="0"
                         IsReadOnly="True"
                         Padding="8,8"
                         FontFamily="Consolas"
                         FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource LogBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Height="28">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot"
                             Width="8" Height="8"
                             Fill="{StaticResource WarnBrush}"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusLabel"
                               Text="ГОТОВ К РАБОТЕ"
                               Style="{StaticResource MonoLabel}"
                               FontSize="11"/>
                </StackPanel>

                <TextBlock x:Name="TxtNext"
                           Style="{StaticResource MonoLabel}"
                           FontSize="11"
                           Foreground="{StaticResource Text2Brush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Button x:Name="BtnToggle"
                        Content="Запустить"
                        Style="{StaticResource AccentBtn}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="BtnToggle_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
