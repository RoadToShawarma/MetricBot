<Window x:Class="MetricBot.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Защита MetricBot"
        Width="390" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="True"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Consolas"
        Loaded="Window_Loaded">
    <Border Padding="24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Text="METRICBOT ЗАБЛОКИРОВАН"
                       Style="{StaticResource SectionLabel}" FontSize="16"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock x:Name="TxtHint" Text="Введите пароль для управления приложением"
                       Style="{StaticResource MonoLabel}" Foreground="{StaticResource Text2Brush}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>
            <PasswordBox x:Name="PwdCurrent" Height="34" Padding="8,6"
                         Background="{StaticResource InputBgBrush}" Foreground="{StaticResource AccentBrush}"
                         BorderBrush="{StaticResource BorderBrush}" PasswordChar="●"
                         KeyDown="Password_KeyDown"/>
            <PasswordBox x:Name="PwdNew" Height="34" Padding="8,6" Margin="0,10,0,0"
                         Background="{StaticResource InputBgBrush}" Foreground="{StaticResource AccentBrush}"
                         BorderBrush="{StaticResource BorderBrush}" PasswordChar="●"
                         KeyDown="Password_KeyDown" Visibility="Collapsed"/>
            <PasswordBox x:Name="PwdConfirm" Height="34" Padding="8,6" Margin="0,10,0,0"
                         Background="{StaticResource InputBgBrush}" Foreground="{StaticResource AccentBrush}"
                         BorderBrush="{StaticResource BorderBrush}" PasswordChar="●"
                         KeyDown="Password_KeyDown" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtError" Foreground="{StaticResource ErrorBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Отмена" Style="{StaticResource OutlineBtn}" Margin="0,0,10,0"
                        IsCancel="True"/>
                <Button x:Name="BtnConfirm" Content="Разблокировать" Style="{StaticResource AccentBtn}"
                        IsDefault="True" Click="BtnConfirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
